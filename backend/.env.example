GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=6
EXPANDED_RETRIEVAL_CANDIDATES=40
RETRIEVAL_CONTEXT_TOKENS=6000
RETRIEVAL_RESERVED_TOKENS=1000
# Optional local tokenizer directory for the generation model (no downloads).
GENERATION_TOKENIZER_PATH=
# Full QA prompt budget, including history/evidence; output and framing are reserved.
CHAT_CONTEXT_TOKENS=16000
CHAT_OUTPUT_TOKENS=2048
CHAT_HISTORY_TOKENS=2400
CHAT_SAFETY_TOKENS=256
CHAT_MEMORY_TOKENS=10000
CHAT_MAX_TURNS=12
CHAT_TTL_SECONDS=86400
# Summary input includes system instructions; output reserve keeps requests below 8k.
SUMMARY_INPUT_TOKENS=5500
SUMMARY_OUTPUT_TOKENS=2048
SUMMARY_MAX_TIMEOUT_SECONDS=7200
# Match these to the actual account/model limits; summaries share a paced budget.
SUMMARY_MODEL=openai/gpt-oss-120b
SUMMARY_REQUESTS_PER_MINUTE=20
SUMMARY_TOKENS_PER_MINUTE=8000
# Large books: scan every page, select informative excerpts locally, then synthesize.
SUMMARY_DIGEST_THRESHOLD_PAGES=80
SUMMARY_PAGE_DIGEST_CHARS=900
